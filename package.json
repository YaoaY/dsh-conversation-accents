{
  "name": "dsh-conversation-accents",
  "version": "0.1.0-alpha.1",
  "description": "Toggleable assistant, tool, and Think accents with safe Think Markdown for DSH Web",
  "author": "dsh-conversation-accents contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/YaoaY/dsh-conversation-accents.git"
  },
  "homepage": "https://github.com/YaoaY/dsh-conversation-accents#readme",
  "bugs": {
    "url": "https://github.com/YaoaY/dsh-conversation-accents/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./palettes": {
      "types": "./dist/palettes.d.ts",
      "default": "./dist/palettes.js"
    },
    "./dsh.bundle.patch.yml": "./dsh.bundle.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "dist",
    "docs",
    "dsh.bundle.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run typecheck && node --test test/*.test.js",
    "verify:gui": "node scripts/verify-gui.mjs",
    "verify:history": "node scripts/verify-history-performance.mjs",
    "prepack": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "markdown",
    "shiki",
    "syntax-highlighting",
    "conversation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "micromark": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "typescript": "~5.9.3"
  }
}
